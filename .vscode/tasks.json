{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Full Platform (Backend + Frontend)",
      "dependsOn": ["Start Hugg AI Backend", "Start Hugg AI Frontend"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Start Hugg AI Backend",
      "type": "shell",
      "command": "python run.py",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Hugg AI Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Test Proactive AI Business Scan",
      "type": "shell",
      "command": "Invoke-RestMethod -Uri 'http://127.0.0.1:8000/api/ai/scan' -Method Post | ConvertTo-Json",
      "problemMatcher": []
    },
    {
      "label": "Check Business Health Score",
      "type": "shell",
      "command": "Invoke-RestMethod -Uri 'http://127.0.0.1:8000/api/ai/health-score' -Method Get | ConvertTo-Json -Depth 4",
      "problemMatcher": []
    }
  ]
}
