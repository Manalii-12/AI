{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run Full Platform (Backend + Frontend)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "Start Hugg AI Frontend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "▶ Run Hugg AI Backend Only (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "🎙 Run Voice Assistant Terminal (Speaks Aloud)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/voice_cli.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🧪 Run Automated Backend Test Suite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_platform.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
  ]
}
