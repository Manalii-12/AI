# Hugg AI Configuration File

# Project Settings
PROJECT_NAME="Hugg AI Business Operations & Intelligence Platform"
VERSION="1.0.0"
API_PREFIX="/api"

# Database (SQLite by default, or PostgreSQL)
DATABASE_URL="sqlite:///./hugg_business.db"

# =====================================================================
# 🌟 FREE & COMMERCIAL AI LLM PROVIDERS (CHOOSE ANY ONE)
# =====================================================================

# 1. GROQ (100% Free & Ultra-Fast - Recommended)
# Get a free key in 30 seconds at: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=""

# 2. GOOGLE GEMINI (Free Tier - 15 RPM Free)
# Get a free key at: https://aistudio.google.com/
# Supported models: gemini-1.5-flash, gemini-2.0-flash
GEMINI_API_KEY=""

# 3. OPENROUTER (Free models available)
# Get a free key at: https://openrouter.ai/keys
# Example model: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=""

# 4. PERPLEXITY API (Sonar Search & Synthesis)
# Get key at: https://docs.perplexity.ai/
PERPLEXITY_API_KEY=""

# 5. ANTHROPIC CLAUDE
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# 6. OPENAI (GPT-4o / GPT-4o-mini)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# 7. LOCAL OLLAMA (100% Free, Offline, No API Key Needed)
# Download from https://ollama.ai/ and run: ollama run llama3.2
OLLAMA_BASE_URL="http://localhost:11434"

# Optional: Override default model name for whichever provider you selected
LLM_MODEL=""

# Autonomous Monitoring Scan Interval (in minutes)
AI_SCAN_INTERVAL_MINUTES=15
